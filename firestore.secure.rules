rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function userProfile(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == 'm8JbbeeXMmZzywUwHboOyMm9MnG2';
    }

    function isActiveUser(userId) {
      return signedIn()
        && request.auth.uid == userId
        && userExists(userId)
        && userProfile(userId).status == 'active';
    }

    function isActiveAdmin() {
      return signedIn()
        && userExists(request.auth.uid)
        && userProfile(request.auth.uid).role == 'admin'
        && userProfile(request.auth.uid).status == 'active';
    }

    function isModerator() {
      return isOwner() || isActiveAdmin();
    }

    function isOwnProfile(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isActiveRole(userId, role) {
      return signedIn()
        && userExists(userId)
        && userProfile(userId).role == role
        && userProfile(userId).status == 'active';
    }

    function isPublicTutorResource() {
      return signedIn()
        && resource.data.role == 'tutor'
        && resource.data.status == 'active'
        && resource.data.isPublic == true;
    }

    function validNotificationPreferences(data) {
      return data is map
        && data.keys().hasOnly([
          'bookingUpdates', 'newMessages', 'lessonReminders', 'productNews'
        ])
        && data.keys().hasAll([
          'bookingUpdates', 'newMessages', 'lessonReminders', 'productNews'
        ])
        && data.bookingUpdates is bool
        && data.newMessages is bool
        && data.lessonReminders is bool
        && data.productNews is bool;
    }

    function validEditableProfile(data) {
      return data.firstName is string
        && data.firstName.size() > 0
        && data.firstName.size() <= 80
        && data.lastName is string
        && data.lastName.size() > 0
        && data.lastName.size() <= 80
        && data.displayName is string
        && data.displayName == data.firstName + ' ' + data.lastName
        && data.displayName.size() <= 160
        && data.avatar is string
        && data.avatar.size() <= 2000
        && (!(data.keys().hasAny(['fieldOfStudy']))
          || (data.fieldOfStudy is string && data.fieldOfStudy.size() <= 120))
        && (!(data.keys().hasAny(['studyYear']))
          || (data.studyYear is string && data.studyYear.size() <= 20))
        && (!(data.keys().hasAny(['title']))
          || (data.title is string && data.title.size() <= 160))
        && (!(data.keys().hasAny(['specialization']))
          || (data.specialization is string && data.specialization.size() <= 180))
        && (!(data.keys().hasAny(['subjects']))
          || (data.subjects is list && data.subjects.size() <= 30))
        && (!(data.keys().hasAny(['institution']))
          || (data.institution is string && data.institution.size() <= 240))
        && (!(data.keys().hasAny(['experience']))
          || (data.experience is string && data.experience.size() <= 120))
        && (!(data.keys().hasAny(['bio']))
          || (data.bio is string && data.bio.size() <= 4000))
        && (!(data.keys().hasAny(['city']))
          || (data.city is string && data.city.size() <= 160))
        && (!(data.keys().hasAny(['lessonPrice']))
          || (data.lessonPrice is number
            && data.lessonPrice >= 0
            && data.lessonPrice <= 1000000))
        && (!(data.keys().hasAny(['lessonDuration']))
          || (data.lessonDuration is int
            && data.lessonDuration >= 30
            && data.lessonDuration <= 180))
        && (!(data.keys().hasAny(['lessonFormats']))
          || (data.lessonFormats is list
            && data.lessonFormats.size() > 0
            && data.lessonFormats.size() <= 2
            && data.lessonFormats.hasOnly(['online', 'in_person'])))
        && (!(data.keys().hasAny(['timezone']))
          || (data.timezone is string
            && data.timezone.size() > 0
            && data.timezone.size() <= 80))
        && (!(data.keys().hasAny(['notificationPreferences']))
          || validNotificationPreferences(data.notificationPreferences))
        && data.onboardingCompleted is bool
        && data.updatedAt is timestamp;
    }

    function validNewProfile(userId) {
      return request.resource.data.keys().hasOnly([
          'uid', 'firstName', 'lastName', 'displayName', 'email', 'role',
          'status', 'statusBeforeBlock', 'avatar', 'fieldOfStudy',
          'studyYear', 'title', 'specialization', 'subjects',
          'institution', 'experience', 'bio', 'city', 'lessonPrice',
          'lessonDuration', 'lessonFormats', 'timezone', 'rating',
          'reviewsCount', 'isPublic', 'notificationPreferences',
          'moderationNote', 'moderatedBy', 'moderatedAt',
          'onboardingCompleted', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'firstName', 'lastName', 'displayName', 'email', 'role',
          'status', 'avatar', 'rating', 'reviewsCount', 'isPublic',
          'onboardingCompleted', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && validEditableProfile(request.resource.data)
        && request.resource.data.rating == 0
        && request.resource.data.reviewsCount == 0
        && request.resource.data.isPublic == false
        && request.resource.data.createdAt is timestamp
        && (
          (
            request.resource.data.role == 'student'
            && request.resource.data.status == 'active'
          )
          || (
            request.resource.data.role == 'tutor'
            && request.resource.data.status == 'pending'
          )
        );
    }

    function safeSelfUpdate() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.rating == resource.data.rating
        && request.resource.data.reviewsCount == resource.data.reviewsCount
        && request.resource.data.isPublic == resource.data.isPublic
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'displayName', 'avatar',
          'fieldOfStudy', 'studyYear', 'title', 'specialization',
          'subjects', 'institution', 'experience', 'bio', 'city',
          'lessonPrice', 'lessonDuration', 'lessonFormats', 'timezone',
          'notificationPreferences', 'onboardingCompleted', 'updatedAt'
        ])
        && validEditableProfile(request.resource.data);
    }

    function validTutorResubmission() {
      return resource.data.role == 'tutor'
        && resource.data.status == 'rejected'
        && request.resource.data.status == 'pending'
        && request.resource.data.isPublic == false
        && request.resource.data.moderationNote == ''
        && request.resource.data.moderatedBy == ''
        && request.resource.data.moderatedAt == null
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'isPublic', 'moderationNote', 'moderatedBy',
          'moderatedAt', 'updatedAt'
        ]);
    }

    function validAdminTutorModeration() {
      return resource.data.role == 'tutor'
        && resource.data.status == 'pending'
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status in ['active', 'rejected']
        && request.resource.data.isPublic
          == (request.resource.data.status == 'active')
        && request.resource.data.moderatedBy == request.auth.uid
        && request.resource.data.moderatedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'isPublic', 'moderationNote', 'moderatedBy',
          'moderatedAt', 'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow create: if false;
      allow get: if isModerator()
        || (signedIn() && isOwnProfile(userId))
        || isPublicTutorResource();
      allow list: if isModerator() || isPublicTutorResource();
      allow update: if isOwner()
        || (isActiveAdmin() && validAdminTutorModeration())
        || (
          signedIn()
          && isOwnProfile(userId)
          && userExists(userId)
          && resource.data.status != 'blocked'
          && resource.data.status != 'deleted'
          && (safeSelfUpdate() || validTutorResubmission())
        );
      allow delete: if isOwner();

      match /knowledgeBookmarks/{resourceId} {
        allow read: if isActiveUser(userId);
        allow create: if isActiveUser(userId)
          && resourceId.size() > 0
          && resourceId.size() <= 220
          && request.resource.data.keys().hasOnly(['resourceId', 'createdAt'])
          && request.resource.data.resourceId == resourceId
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if isActiveUser(userId);
      }
    }

    function validTutorPrivateProfile(tutorId) {
      return request.resource.data.keys().hasOnly([
          'tutorUid', 'qualificationReference', 'updatedAt'
        ])
        && request.resource.data.tutorUid == tutorId
        && request.resource.data.qualificationReference is string
        && request.resource.data.qualificationReference.size() <= 300
        && request.resource.data.updatedAt is timestamp;
    }

    match /tutorPrivateProfiles/{tutorId} {
      allow read: if isModerator() || isActiveUser(tutorId);
      allow create, update: if isActiveUser(tutorId)
        && userProfile(tutorId).role == 'tutor'
        && validTutorPrivateProfile(tutorId);
      allow delete: if isOwner() || isActiveUser(tutorId);
    }

    function validBookingCreate() {
      return request.resource.data.keys().hasAll([
          'studentUid', 'studentName', 'studentAvatar', 'tutorUid',
          'tutorName', 'tutorAvatar', 'subject', 'goal', 'requestedDate',
          'requestedTime', 'timezone', 'durationMinutes', 'format', 'price',
          'status', 'studentMessage', 'tutorResponse', 'conversationId',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.studentUid == request.auth.uid
        && isActiveRole(request.auth.uid, 'student')
        && isActiveRole(request.resource.data.tutorUid, 'tutor')
        && userProfile(request.resource.data.tutorUid).isPublic == true
        && request.resource.data.studentName
          == userProfile(request.auth.uid).displayName
        && request.resource.data.studentAvatar
          == userProfile(request.auth.uid).avatar
        && request.resource.data.tutorName
          == userProfile(request.resource.data.tutorUid).displayName
        && request.resource.data.tutorAvatar
          == userProfile(request.resource.data.tutorUid).avatar
        && request.resource.data.durationMinutes
          == userProfile(request.resource.data.tutorUid).lessonDuration
        && request.resource.data.price
          == userProfile(request.resource.data.tutorUid).lessonPrice
        && request.resource.data.format
          in userProfile(request.resource.data.tutorUid).lessonFormats
        && request.resource.data.conversationId
          == (
            request.auth.uid < request.resource.data.tutorUid
              ? request.auth.uid + '__' + request.resource.data.tutorUid
              : request.resource.data.tutorUid + '__' + request.auth.uid
          )
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 160
        && request.resource.data.goal is string
        && request.resource.data.goal.size() <= 4000
        && request.resource.data.requestedDate is string
        && request.resource.data.requestedDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.requestedTime is string
        && request.resource.data.requestedTime.matches('[0-9]{2}:[0-9]{2}')
        && request.resource.data.timezone is string
        && request.resource.data.timezone.size() > 0
        && request.resource.data.timezone.size() <= 80
        && request.resource.data.durationMinutes is int
        && request.resource.data.durationMinutes >= 30
        && request.resource.data.durationMinutes <= 180
        && request.resource.data.format in ['online', 'in_person']
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.status == 'pending'
        && request.resource.data.studentMessage is string
        && request.resource.data.studentMessage.size() <= 2000
        && request.resource.data.tutorResponse == ''
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isActiveBookingParticipant() {
      return signedIn()
        && userExists(request.auth.uid)
        && userProfile(request.auth.uid).status == 'active'
        && (
          resource.data.studentUid == request.auth.uid
          || resource.data.tutorUid == request.auth.uid
        );
    }

    function validTutorBookingDecision() {
      return isActiveRole(request.auth.uid, 'tutor')
        && request.auth.uid == resource.data.tutorUid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.tutorResponse is string
        && request.resource.data.tutorResponse.size() <= 2000
        && request.resource.data.updatedAt is timestamp
        && (
          request.resource.data.status != 'accepted'
          || request.resource.data.confirmedAt is timestamp
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'tutorResponse', 'confirmedAt', 'updatedAt'
        ]);
    }

    function validStudentBookingCancellation() {
      return isActiveRole(request.auth.uid, 'student')
        && request.auth.uid == resource.data.studentUid
        && resource.data.status in ['pending', 'accepted']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt'
        ]);
    }

    function validTutorBookingCompletion() {
      return isActiveRole(request.auth.uid, 'tutor')
        && request.auth.uid == resource.data.tutorUid
        && resource.data.status == 'accepted'
        && request.resource.data.status == 'completed'
        && request.resource.data.completedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'completedAt', 'updatedAt'
        ]);
    }

    match /bookings/{bookingId} {
      allow create: if false;
      allow read: if isModerator() || isActiveBookingParticipant();
      allow update: if isOwner()
        || (signedIn() && (
          validTutorBookingDecision()
          || validStudentBookingCancellation()
          || validTutorBookingCompletion()
        ));
      allow delete: if isOwner();
    }

    function conversationExists(conversationId) {
      return exists(/databases/$(database)/documents/conversations/$(conversationId));
    }

    function conversationParticipant(conversationId) {
      return signedIn()
        && userExists(request.auth.uid)
        && userProfile(request.auth.uid).status == 'active'
        && conversationExists(conversationId)
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participantUids;
    }

    function conversationParticipantAfter(conversationId) {
      return signedIn()
        && userExists(request.auth.uid)
        && userProfile(request.auth.uid).status == 'active'
        && request.auth.uid in getAfter(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participantUids;
    }

    function validConversationCreate(conversationId) {
      return request.resource.data.keys().hasAll([
          'participantUids', 'participantNames', 'participantAvatars',
          'latestBookingId', 'lastMessage', 'lastSenderUid', 'lastMessageAt',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantUids[0]
          != request.resource.data.participantUids[1]
        && request.auth.uid in request.resource.data.participantUids
        && conversationId
          == (
            request.resource.data.participantUids[0]
              < request.resource.data.participantUids[1]
              ? request.resource.data.participantUids[0]
                + '__' + request.resource.data.participantUids[1]
              : request.resource.data.participantUids[1]
                + '__' + request.resource.data.participantUids[0]
          )
        && isActiveRole(request.resource.data.participantUids[0],
          userProfile(request.resource.data.participantUids[0]).role)
        && isActiveRole(request.resource.data.participantUids[1],
          userProfile(request.resource.data.participantUids[1]).role)
        && (
          (
            userProfile(request.resource.data.participantUids[0]).role == 'student'
            && userProfile(request.resource.data.participantUids[1]).role == 'tutor'
          )
          ||
          (
            userProfile(request.resource.data.participantUids[0]).role == 'tutor'
            && userProfile(request.resource.data.participantUids[1]).role == 'student'
          )
        )
        && request.resource.data.participantNames is map
        && request.resource.data.participantAvatars is map
        && request.resource.data.latestBookingId is string
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastMessageAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validConversationUpdate() {
      return conversationParticipant(resource.id)
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.participantNames == resource.data.participantNames
        && request.resource.data.participantAvatars == resource.data.participantAvatars
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastMessageAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'latestBookingId', 'lastMessage', 'lastSenderUid',
          'lastMessageAt', 'updatedAt'
        ]);
    }

    match /conversations/{conversationId} {
      allow create: if false;
      allow read: if isModerator()
        || (signedIn()
          && userExists(request.auth.uid)
          && userProfile(request.auth.uid).status == 'active'
          && request.auth.uid in resource.data.participantUids);
      allow update: if isOwner() || (signedIn() && validConversationUpdate());
      allow delete: if isOwner();

      match /messages/{messageId} {
        allow read: if isModerator() || conversationParticipant(conversationId);
        allow create: if conversationParticipantAfter(conversationId)
          && request.resource.data.keys().hasOnly([
            'senderUid', 'text', 'createdAt'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if isOwner();
      }
    }

    function validAvailabilityDay(day) {
      return day is map
        && day.keys().hasOnly(['enabled', 'start', 'end'])
        && day.keys().hasAll(['enabled', 'start', 'end'])
        && day.enabled is bool
        && day.start is string
        && day.start.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && day.end is string
        && day.end.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && (!day.enabled || day.start != day.end);
    }

    function validAvailability(data, tutorId) {
      return data.keys().hasOnly(['tutorUid', 'timezone', 'days', 'updatedAt'])
        && data.keys().hasAll(['tutorUid', 'timezone', 'days', 'updatedAt'])
        && data.tutorUid == tutorId
        && data.timezone is string
        && data.timezone.size() > 0
        && data.timezone.size() <= 80
        && data.days is map
        && data.days.keys().hasOnly([
          'monday', 'tuesday', 'wednesday', 'thursday',
          'friday', 'saturday', 'sunday'
        ])
        && data.days.keys().hasAll([
          'monday', 'tuesday', 'wednesday', 'thursday',
          'friday', 'saturday', 'sunday'
        ])
        && validAvailabilityDay(data.days.monday)
        && validAvailabilityDay(data.days.tuesday)
        && validAvailabilityDay(data.days.wednesday)
        && validAvailabilityDay(data.days.thursday)
        && validAvailabilityDay(data.days.friday)
        && validAvailabilityDay(data.days.saturday)
        && validAvailabilityDay(data.days.sunday)
        && data.updatedAt is timestamp;
    }

    match /availability/{tutorId} {
      allow read: if signedIn()
        && userExists(request.auth.uid)
        && userProfile(request.auth.uid).status == 'active';
      allow create, update: if isActiveRole(tutorId, 'tutor')
        && request.auth.uid == tutorId
        && validAvailability(request.resource.data, tutorId);
      allow delete: if isOwner() || isActiveRole(tutorId, 'tutor');
    }

    function materialBooking(data) {
      return get(/databases/$(database)/documents/bookings/$(data.bookingId)).data;
    }

    function validMaterialCreate() {
      return request.resource.data.keys().hasAll([
          'bookingId', 'tutorUid', 'tutorName', 'studentUid', 'studentName',
          'title', 'description', 'url', 'kind', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.tutorUid == request.auth.uid
        && isActiveRole(request.auth.uid, 'tutor')
        && exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
        && materialBooking(request.resource.data).tutorUid == request.auth.uid
        && materialBooking(request.resource.data).studentUid
          == request.resource.data.studentUid
        && materialBooking(request.resource.data).status in ['accepted', 'completed']
        && request.resource.data.tutorName
          == userProfile(request.auth.uid).displayName
        && request.resource.data.studentName
          == userProfile(request.resource.data.studentUid).displayName
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 4000
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 2000
        && request.resource.data.kind in ['link', 'document', 'video', 'note']
        && (
          (request.resource.data.kind == 'note' && request.resource.data.url == '')
          || (
            request.resource.data.kind in ['link', 'document', 'video']
            && request.resource.data.url.matches('https://.+')
          )
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /materials/{materialId} {
      allow create: if signedIn() && validMaterialCreate();
      allow read: if isModerator()
        || (
          signedIn()
          && userExists(request.auth.uid)
          && userProfile(request.auth.uid).status == 'active'
          && (
            resource.data.tutorUid == request.auth.uid
            || resource.data.studentUid == request.auth.uid
          )
        );
      allow update: if isActiveRole(request.auth.uid, 'tutor')
        && resource.data.tutorUid == request.auth.uid
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.kind in ['link', 'document', 'video', 'note']
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 2000
        && (
          (request.resource.data.kind == 'note' && request.resource.data.url == '')
          || (
            request.resource.data.kind in ['link', 'document', 'video']
            && request.resource.data.url.matches('https://.+')
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'url', 'kind', 'updatedAt'
        ]);
      allow delete: if isOwner()
        || (isActiveRole(request.auth.uid, 'tutor')
          && resource.data.tutorUid == request.auth.uid);
    }

    function validKnowledgeSubmissionCreate(submissionId) {
      return request.resource.data.keys().hasOnly([
          'origin', 'status', 'title', 'description', 'kind', 'discipline',
          'level', 'author', 'publicationYear', 'sourceMode', 'sourceUrl',
          'filePath', 'fileName', 'fileSize', 'mimeType', 'submittedByUid',
          'submittedByName', 'rightsConfirmed', 'medicalConfirmed',
          'noPatientDataConfirmed', 'moderationNote', 'moderatedBy',
          'moderatedAt', 'publishedAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.origin == 'tutor'
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedByUid == request.auth.uid
        && isActiveRole(request.auth.uid, 'tutor')
        && request.resource.data.submittedByName
          == userProfile(request.auth.uid).displayName
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 180
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 20
        && request.resource.data.description.size() <= 4000
        && request.resource.data.kind in [
          'book', 'clinical_guideline', 'instruction', 'standard',
          'checklist', 'video', 'article'
        ]
        && request.resource.data.discipline in [
          'general', 'anatomy', 'physiology', 'pharmacology', 'therapy',
          'surgery', 'pediatrics', 'nursing', 'emergency', 'accreditation'
        ]
        && request.resource.data.level in [
          'all', 'college', 'university', 'residency'
        ]
        && request.resource.data.author is string
        && request.resource.data.author.size() >= 2
        && request.resource.data.author.size() <= 160
        && request.resource.data.publicationYear is string
        && request.resource.data.publicationYear.size() <= 20
        && request.resource.data.sourceMode in ['link', 'file']
        && request.resource.data.sourceUrl is string
        && request.resource.data.sourceUrl.size() <= 2000
        && request.resource.data.filePath is string
        && request.resource.data.filePath.size() <= 1000
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() <= 240
        && request.resource.data.fileSize is int
        && request.resource.data.fileSize >= 0
        && request.resource.data.fileSize <= 25 * 1024 * 1024
        && request.resource.data.mimeType is string
        && (
          (
            request.resource.data.sourceMode == 'link'
            && request.resource.data.sourceUrl.matches('https://.+')
            && request.resource.data.filePath == ''
            && request.resource.data.fileName == ''
            && request.resource.data.fileSize == 0
            && request.resource.data.mimeType == ''
          )
          ||
          (
            request.resource.data.sourceMode == 'file'
            && request.resource.data.sourceUrl == ''
            && request.resource.data.filePath.matches(
              'knowledge-submissions/' + request.auth.uid + '/'
                + submissionId + '/[^/]+[.]pdf'
            )
            && request.resource.data.fileName.matches('.+[.]pdf')
            && request.resource.data.fileSize > 0
            && request.resource.data.mimeType == 'application/pdf'
          )
        )
        && request.resource.data.rightsConfirmed == true
        && request.resource.data.medicalConfirmed == true
        && request.resource.data.noPatientDataConfirmed == true
        && request.resource.data.moderationNote == ''
        && request.resource.data.moderatedBy == ''
        && request.resource.data.moderatedAt == null
        && request.resource.data.publishedAt == null
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validKnowledgeModeration() {
      return resource.data.origin == 'tutor'
        && resource.data.status == 'pending'
        && request.resource.data.origin == resource.data.origin
        && request.resource.data.submittedByUid == resource.data.submittedByUid
        && request.resource.data.status in ['published', 'rejected']
        && request.resource.data.moderationNote is string
        && request.resource.data.moderationNote.size() <= 1000
        && request.resource.data.moderatedBy == request.auth.uid
        && request.resource.data.moderatedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          (
            request.resource.data.status == 'published'
            && request.resource.data.publishedAt is timestamp
          )
          ||
          (
            request.resource.data.status == 'rejected'
            && request.resource.data.moderationNote.size() >= 3
            && request.resource.data.publishedAt == null
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'moderationNote', 'moderatedBy', 'moderatedAt',
          'publishedAt', 'updatedAt'
        ]);
    }

    match /knowledgeSubmissions/{submissionId} {
      allow create: if signedIn() && validKnowledgeSubmissionCreate(submissionId);
      allow read: if isModerator()
        || (
          signedIn()
          && userExists(request.auth.uid)
          && userProfile(request.auth.uid).status == 'active'
          && (
            resource.data.status == 'published'
            || resource.data.submittedByUid == request.auth.uid
          )
        );
      allow update: if isModerator() && validKnowledgeModeration();
      allow delete: if isModerator()
        || (
          isActiveRole(request.auth.uid, 'tutor')
          && resource.data.submittedByUid == request.auth.uid
          && resource.data.status in ['pending', 'rejected']
        );
    }

    function whiteboardBooking(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
    }

    function bookingExists(bookingId) {
      return exists(/databases/$(database)/documents/bookings/$(bookingId));
    }

    function isActiveLessonParticipant(bookingId) {
      return signedIn()
        && userExists(request.auth.uid)
        && userProfile(request.auth.uid).status == 'active'
        && bookingExists(bookingId)
        && (
          whiteboardBooking(bookingId).studentUid == request.auth.uid
          || whiteboardBooking(bookingId).tutorUid == request.auth.uid
        );
    }

    function canReadLessonData(bookingId) {
      return bookingExists(bookingId)
        && (
          isModerator()
          || (
            isActiveLessonParticipant(bookingId)
            && (
              whiteboardBooking(bookingId).status == 'accepted'
              || (
                whiteboardBooking(bookingId).status == 'completed'
                && whiteboardBooking(bookingId).completedAt is timestamp
                && request.time
                  < whiteboardBooking(bookingId).completedAt
                    + duration.value(180, 'd')
              )
            )
          )
        );
    }

    function canWriteLessonData(bookingId) {
      return bookingExists(bookingId)
        && whiteboardBooking(bookingId).status == 'accepted'
        && isActiveLessonParticipant(bookingId);
    }

    function isLessonTutor(bookingId) {
      return canWriteLessonData(bookingId)
        && whiteboardBooking(bookingId).tutorUid == request.auth.uid;
    }

    function validWhiteboardElement(data, elementId) {
      return data.keys().hasOnly([
          'id', 'kind', 'color', 'size', 'opacity', 'authorUid',
          'authorName', 'points', 'x', 'y', 'endX', 'endY', 'text',
          'createdAtMs', 'createdAt', 'updatedAt'
        ])
        && data.id == elementId
        && data.kind in [
          'pen', 'marker', 'eraser', 'line', 'rectangle', 'ellipse', 'text'
        ]
        && data.color is string
        && data.color.size() <= 16
        && data.size is number
        && data.size >= 1
        && data.size <= 40
        && data.opacity is number
        && data.opacity >= 0.1
        && data.opacity <= 1
        && data.authorUid == request.auth.uid
        && data.authorName == userProfile(request.auth.uid).displayName
        && data.points is list
        && data.points.size() <= 1200
        && data.x is number
        && data.y is number
        && data.endX is number
        && data.endY is number
        && data.x >= 0 && data.x <= 1
        && data.y >= 0 && data.y <= 1
        && data.endX >= 0 && data.endX <= 1
        && data.endY >= 0 && data.endY <= 1
        && data.text is string
        && data.text.size() <= 500
        && data.createdAtMs is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /whiteboards/{bookingId} {
      allow read, write: if false;

      match /elements/{elementId} {
        allow read: if canReadLessonData(bookingId);
        allow create: if canWriteLessonData(bookingId)
          && validWhiteboardElement(request.resource.data, elementId);
        allow update: if canWriteLessonData(bookingId)
          && resource.data.authorUid == request.auth.uid
          && validWhiteboardElement(request.resource.data, elementId);
        allow delete: if isOwner()
          || (
            canWriteLessonData(bookingId)
            && (
              resource.data.authorUid == request.auth.uid
              || isLessonTutor(bookingId)
            )
          );
      }
    }

    function validClinicalCase(data) {
      return data is map
        && data.keys().hasOnly([
          'complaint', 'anamnesis', 'examination', 'diagnosis',
          'differential', 'plan', 'teachingGoal'
        ])
        && data.keys().hasAll([
          'complaint', 'anamnesis', 'examination', 'diagnosis',
          'differential', 'plan', 'teachingGoal'
        ])
        && data.complaint is string && data.complaint.size() <= 4000
        && data.anamnesis is string && data.anamnesis.size() <= 8000
        && data.examination is string && data.examination.size() <= 8000
        && data.diagnosis is string && data.diagnosis.size() <= 4000
        && data.differential is string && data.differential.size() <= 8000
        && data.plan is string && data.plan.size() <= 8000
        && data.teachingGoal is string && data.teachingGoal.size() <= 4000;
    }

    function validEcg(data) {
      return data is map
        && data.keys().hasOnly([
          'rhythm', 'heartRate', 'axis', 'prMs', 'qrsMs',
          'qtMs', 'qtcMs', 'conclusion'
        ])
        && data.keys().hasAll([
          'rhythm', 'heartRate', 'axis', 'prMs', 'qrsMs',
          'qtMs', 'qtcMs', 'conclusion'
        ])
        && data.rhythm is string && data.rhythm.size() <= 160
        && data.heartRate is string && data.heartRate.size() <= 20
        && data.axis is string && data.axis.size() <= 160
        && data.prMs is string && data.prMs.size() <= 20
        && data.qrsMs is string && data.qrsMs.size() <= 20
        && data.qtMs is string && data.qtMs.size() <= 20
        && data.qtcMs is string && data.qtcMs.size() <= 20
        && data.conclusion is string && data.conclusion.size() <= 8000;
    }

    function validPrivacy(data) {
      return data is map
        && data.keys().hasOnly([
          'deidentified', 'identifiersRemoved', 'consentConfirmed',
          'educationalUseOnly', 'patientLabel'
        ])
        && data.keys().hasAll([
          'deidentified', 'identifiersRemoved', 'consentConfirmed',
          'educationalUseOnly', 'patientLabel'
        ])
        && data.deidentified is bool
        && data.identifiersRemoved is bool
        && data.consentConfirmed is bool
        && data.educationalUseOnly is bool
        && data.patientLabel is string
        && data.patientLabel.size() <= 160;
    }

    function validBoardBackground(data) {
      return data is map
        && data.keys().hasOnly([
          'kind', 'assetId', 'label', 'anatomyLayer',
          'anatomyView', 'anatomyRegion'
        ])
        && data.keys().hasAll([
          'kind', 'assetId', 'label', 'anatomyLayer',
          'anatomyView', 'anatomyRegion'
        ])
        && data.kind in ['none', 'image', 'anatomy']
        && data.assetId is string && data.assetId.size() <= 220
        && data.label is string && data.label.size() <= 240
        && data.anatomyLayer in ['organs', 'skeleton', 'vessels']
        && data.anatomyView in ['front', 'left', 'back', 'right']
        && data.anatomyRegion is string
        && data.anatomyRegion.size() <= 80;
    }

    function validMedicalWorkspace(data, bookingId) {
      return data.keys().hasOnly([
          'bookingId', 'clinicalCase', 'labs', 'ecg', 'privacy',
          'boardBackground', 'updatedByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'bookingId', 'clinicalCase', 'labs', 'ecg', 'privacy',
          'boardBackground', 'updatedByUid', 'createdAt', 'updatedAt'
        ])
        && data.bookingId == bookingId
        && validClinicalCase(data.clinicalCase)
        && data.labs is list
        && data.labs.size() <= 100
        && validEcg(data.ecg)
        && validPrivacy(data.privacy)
        && validBoardBackground(data.boardBackground)
        && data.updatedByUid == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /adminAuditLogs/{logId} {
      // Administrative audit entries are written only by Firebase Admin SDK.
      // Only the immutable primary owner may read the complete security trail.
      allow read: if isOwner();
      allow create, update, delete: if false;
    }

    match /medicalWorkspaces/{bookingId} {
      allow read: if canReadLessonData(bookingId);
      allow create: if canWriteLessonData(bookingId)
        && validMedicalWorkspace(request.resource.data, bookingId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if canWriteLessonData(bookingId)
        && validMedicalWorkspace(request.resource.data, bookingId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner();

      match /assets/{assetId} {
        allow read: if canReadLessonData(bookingId);
        // Direct medical-file uploads are disabled until a trusted server-side
        // de-identification and malware-scanning pipeline is connected.
        allow create, update: if false;
        allow delete: if isOwner()
          || (
            canWriteLessonData(bookingId)
            && (
              resource.data.uploaderUid == request.auth.uid
              || isLessonTutor(bookingId)
            )
          );
      }
    }
  }
}
