rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentUserExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentRole() {
      return currentUserExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return currentRole() == 'admin';
    }

    match /users/{uid} {
      allow create: if ownUser(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['student', 'tutor']
        && (
          (request.resource.data.role == 'student' && request.resource.data.status == 'active') ||
          (request.resource.data.role == 'tutor' && request.resource.data.status == 'pending')
        );

      allow read: if ownUser(uid) || isAdmin();

      allow update: if isAdmin() || (
        ownUser(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.isPublic == resource.data.isPublic
      );

      allow delete: if isAdmin();
    }

    match /tutors/{uid} {
      allow read: if isAdmin() || (
        resource.data.status == 'active'
        && resource.data.isPublic == true
      );
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
