rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userExists(userId) {
      return exists(
        /databases/$(database)/documents/users/$(userId)
      );
    }

    function userProfile(userId) {
      return get(
        /databases/$(database)/documents/users/$(userId)
      ).data;
    }

    function hasUsableAccount() {
      return signedIn()
        && userExists(request.auth.uid)
        && userProfile(request.auth.uid).status != 'blocked'
        && userProfile(request.auth.uid).status != 'deleted';
    }

    function isOwner() {
      return hasUsableAccount()
        && request.auth.uid == 'm8JbbeeXMmZzywUwHboOyMm9MnG2';
    }

    function isActiveAdmin() {
      return signedIn()
        && userExists(request.auth.uid)
        && userProfile(request.auth.uid).role == 'admin'
        && userProfile(request.auth.uid).status == 'active';
    }

    function isModerator() {
      return isOwner() || isActiveAdmin();
    }

    function isOwnProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isActiveRole(userId, role) {
      return signedIn()
        && userExists(userId)
        && userProfile(userId).role == role
        && userProfile(userId).status == 'active';
    }

    function isPublicTutor() {
      return signedIn()
        && resource.data.role == 'tutor'
        && resource.data.status == 'active'
        && resource.data.isPublic == true;
    }

    function validNewProfile(userId) {
      return request.resource.data.keys().hasAll([
          'uid',
          'firstName',
          'lastName',
          'displayName',
          'email',
          'role',
          'status',
          'rating',
          'reviewsCount',
          'isPublic',
          'onboardingCompleted',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.rating == 0
        && request.resource.data.reviewsCount == 0
        && request.resource.data.isPublic == false
        && request.resource.data.onboardingCompleted is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          (
            request.resource.data.role == 'student'
            && request.resource.data.status == 'active'
          )
          ||
          (
            request.resource.data.role == 'tutor'
            && request.resource.data.status == 'pending'
          )
        );
    }

    function safeSelfUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasNone([
        'uid',
        'email',
        'role',
        'status',
        'rating',
        'reviewsCount',
        'isPublic',
        'moderationNote',
        'moderatedBy',
        'moderatedAt',
        'createdAt'
      ]);
    }

    function validTutorResubmission() {
      return resource.data.role == 'tutor'
        && resource.data.status == 'rejected'
        && request.resource.data.status == 'pending'
        && request.resource.data.isPublic == false
        && request.resource.data.moderationNote == ''
        && request.resource.data.moderatedBy == ''
        && request.resource.data.moderatedAt == null
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'isPublic',
          'moderationNote',
          'moderatedBy',
          'moderatedAt',
          'updatedAt'
        ]);
    }

    function validAdminTutorModeration() {
      return resource.data.role == 'tutor'
        && resource.data.status == 'pending'
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && (
          request.resource.data.status == 'active'
          || request.resource.data.status == 'rejected'
        )
        && request.resource.data.isPublic
          == (request.resource.data.status == 'active')
        && request.resource.data.moderatedBy == request.auth.uid
        && request.resource.data.moderatedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'isPublic',
          'moderationNote',
          'moderatedBy',
          'moderatedAt',
          'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow create: if isOwnProfile(userId) && validNewProfile(userId);

      allow get: if isModerator()
        || isOwnProfile(userId)
        || isPublicTutor();

      allow list: if isModerator() || isPublicTutor();

      allow update: if isOwner()
        || (isActiveAdmin() && validAdminTutorModeration())
        || (
          isOwnProfile(userId)
          && (safeSelfUpdate() || validTutorResubmission())
        );

      allow delete: if isOwner();
    }

    match /users/{userId}/knowledgeBookmarks/{resourceId} {
      allow read: if isOwnProfile(userId) && hasUsableAccount();
      allow create: if isOwnProfile(userId) && hasUsableAccount()
        && resourceId.size() > 0
        && resourceId.size() <= 220
        && request.resource.data.keys().hasOnly([
          'resourceId',
          'createdAt'
        ])
        && request.resource.data.resourceId == resourceId
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if isOwnProfile(userId) && hasUsableAccount();
    }

    function validTutorPrivateProfile(tutorId) {
      return request.resource.data.keys().hasOnly([
          'tutorUid',
          'qualificationReference',
          'updatedAt'
        ])
        && request.resource.data.tutorUid == tutorId
        && request.resource.data.qualificationReference is string
        && request.resource.data.qualificationReference.size() <= 300
        && request.resource.data.updatedAt is timestamp;
    }

    match /tutorPrivateProfiles/{tutorId} {
      allow read: if isModerator() || isOwnProfile(tutorId);
      allow create, update: if isOwnProfile(tutorId)
        && userExists(tutorId)
        && userProfile(tutorId).role == 'tutor'
        && validTutorPrivateProfile(tutorId);
      allow delete: if isOwner() || isOwnProfile(tutorId);
    }

    function validBookingCreate() {
      return request.resource.data.keys().hasAll([
          'studentUid',
          'studentName',
          'studentAvatar',
          'tutorUid',
          'tutorName',
          'tutorAvatar',
          'subject',
          'goal',
          'requestedDate',
          'requestedTime',
          'timezone',
          'durationMinutes',
          'format',
          'price',
          'status',
          'studentMessage',
          'tutorResponse',
          'conversationId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.studentUid == request.auth.uid
        && isActiveRole(request.auth.uid, 'student')
        && isActiveRole(request.resource.data.tutorUid, 'tutor')
        && userProfile(request.resource.data.tutorUid).isPublic == true
        && request.resource.data.studentName is string
        && request.resource.data.studentAvatar is string
        && request.resource.data.tutorName is string
        && request.resource.data.tutorAvatar is string
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 160
        && request.resource.data.goal is string
        && request.resource.data.requestedDate is string
        && request.resource.data.requestedTime is string
        && request.resource.data.timezone is string
        && request.resource.data.durationMinutes is int
        && request.resource.data.durationMinutes >= 30
        && request.resource.data.durationMinutes <= 180
        && request.resource.data.format in ['online', 'in_person']
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.status == 'pending'
        && request.resource.data.studentMessage is string
        && request.resource.data.studentMessage.size() <= 2000
        && request.resource.data.tutorResponse == ''
        && request.resource.data.conversationId is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isBookingParticipant() {
      return hasUsableAccount()
        && (
          resource.data.studentUid == request.auth.uid
          || resource.data.tutorUid == request.auth.uid
        );
    }

    function validTutorBookingDecision() {
      return request.auth.uid == resource.data.tutorUid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.tutorResponse is string
        && request.resource.data.updatedAt is timestamp
        && (
          request.resource.data.status != 'accepted'
          || request.resource.data.confirmedAt is timestamp
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'tutorResponse',
          'confirmedAt',
          'updatedAt'
        ]);
    }

    function validStudentBookingCancellation() {
      return request.auth.uid == resource.data.studentUid
        && resource.data.status in ['pending', 'accepted']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt'
        ]);
    }

    function validTutorBookingCompletion() {
      return request.auth.uid == resource.data.tutorUid
        && resource.data.status == 'accepted'
        && request.resource.data.status == 'completed'
        && request.resource.data.completedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'completedAt',
          'updatedAt'
        ]);
    }

    match /bookings/{bookingId} {
      // Создание выполняется только серверным API после сверки цены,
      // расписания, статуса аккаунтов и пересечений занятий.
      allow create: if false;
      allow read: if isModerator() || isBookingParticipant();
      allow update: if isOwner()
        || (
          hasUsableAccount()
          && (
            validTutorBookingDecision()
            || validStudentBookingCancellation()
            || validTutorBookingCompletion()
          )
        );
      allow delete: if isOwner();
    }

    function conversationParticipant(conversationId) {
      return hasUsableAccount()
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participantUids;
    }

    function conversationParticipantAfter(conversationId) {
      return hasUsableAccount()
        && request.auth.uid in getAfter(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participantUids;
    }

    function validConversationCreate() {
      return request.resource.data.keys().hasAll([
          'participantUids',
          'participantNames',
          'participantAvatars',
          'latestBookingId',
          'lastMessage',
          'lastSenderUid',
          'lastMessageAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantUids[0]
          != request.resource.data.participantUids[1]
        && request.auth.uid in request.resource.data.participantUids
        && userExists(request.resource.data.participantUids[0])
        && userExists(request.resource.data.participantUids[1])
        && userProfile(request.resource.data.participantUids[0]).status
          == 'active'
        && userProfile(request.resource.data.participantUids[1]).status
          == 'active'
        && request.resource.data.participantNames is map
        && request.resource.data.participantAvatars is map
        && request.resource.data.latestBookingId is string
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastMessageAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validConversationUpdate() {
      return request.auth.uid in resource.data.participantUids
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastMessageAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'latestBookingId',
          'lastMessage',
          'lastSenderUid',
          'lastMessageAt',
          'updatedAt'
        ]);
    }

    match /conversations/{conversationId} {
      allow create: if false;
      allow read: if isModerator()
        || (
          hasUsableAccount()
          && request.auth.uid in resource.data.participantUids
        );
      allow update: if isOwner()
        || (hasUsableAccount() && validConversationUpdate());
      allow delete: if isOwner();

      match /messages/{messageId} {
        allow read: if isModerator()
          || conversationParticipant(conversationId);
        allow create: if conversationParticipantAfter(conversationId)
          && request.resource.data.keys().hasOnly([
            'senderUid',
            'text',
            'createdAt'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if isOwner();
      }
    }

    function validAvailability(data, tutorId) {
      return data.keys().hasAll([
          'tutorUid',
          'timezone',
          'days',
          'updatedAt'
        ])
        && data.tutorUid == tutorId
        && data.timezone is string
        && data.days is map
        && data.updatedAt is timestamp;
    }

    match /availability/{tutorId} {
      allow read: if hasUsableAccount();
      allow create, update: if hasUsableAccount()
        && request.auth.uid == tutorId
        && userExists(tutorId)
        && userProfile(tutorId).role == 'tutor'
        && validAvailability(request.resource.data, tutorId);
      allow delete: if isOwner() || isOwnProfile(tutorId);
    }

    function materialBooking(data) {
      return get(
        /databases/$(database)/documents/bookings/$(data.bookingId)
      ).data;
    }

    function validMaterialCreate() {
      return request.resource.data.keys().hasAll([
          'bookingId',
          'tutorUid',
          'tutorName',
          'studentUid',
          'studentName',
          'title',
          'description',
          'url',
          'kind',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.tutorUid == request.auth.uid
        && isActiveRole(request.auth.uid, 'tutor')
        && exists(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        )
        && materialBooking(request.resource.data).tutorUid
          == request.auth.uid
        && materialBooking(request.resource.data).studentUid
          == request.resource.data.studentUid
        && materialBooking(request.resource.data).status
          in ['accepted', 'completed']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 4000
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 2000
        && request.resource.data.kind
          in ['link', 'document', 'video', 'note']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /materials/{materialId} {
      allow create: if hasUsableAccount() && validMaterialCreate();
      allow read: if isModerator()
        || (
          hasUsableAccount()
          && (
            resource.data.tutorUid == request.auth.uid
            || resource.data.studentUid == request.auth.uid
          )
        );
      allow update: if hasUsableAccount()
        && resource.data.tutorUid == request.auth.uid
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'description',
          'url',
          'kind',
          'updatedAt'
        ]);
      allow delete: if isOwner()
        || (
          hasUsableAccount()
          && resource.data.tutorUid == request.auth.uid
        );
    }

    function validKnowledgeSubmissionCreate(submissionId) {
      return request.resource.data.keys().hasOnly([
          'origin',
          'status',
          'title',
          'description',
          'kind',
          'discipline',
          'level',
          'author',
          'publicationYear',
          'sourceMode',
          'sourceUrl',
          'filePath',
          'fileName',
          'fileSize',
          'mimeType',
          'submittedByUid',
          'submittedByName',
          'rightsConfirmed',
          'medicalConfirmed',
          'noPatientDataConfirmed',
          'moderationNote',
          'moderatedBy',
          'moderatedAt',
          'publishedAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.origin == 'tutor'
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedByUid == request.auth.uid
        && isActiveRole(request.auth.uid, 'tutor')
        && request.resource.data.submittedByName is string
        && request.resource.data.submittedByName.size() > 0
        && request.resource.data.submittedByName.size() <= 160
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 180
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 20
        && request.resource.data.description.size() <= 4000
        && request.resource.data.kind in [
          'book',
          'clinical_guideline',
          'instruction',
          'standard',
          'checklist',
          'video',
          'article'
        ]
        && request.resource.data.discipline in [
          'general',
          'anatomy',
          'physiology',
          'pharmacology',
          'therapy',
          'surgery',
          'pediatrics',
          'nursing',
          'emergency',
          'accreditation'
        ]
        && request.resource.data.level in [
          'all',
          'college',
          'university',
          'residency'
        ]
        && request.resource.data.author is string
        && request.resource.data.author.size() >= 2
        && request.resource.data.author.size() <= 160
        && request.resource.data.publicationYear is string
        && request.resource.data.publicationYear.size() <= 20
        && request.resource.data.sourceMode in ['link', 'file']
        && request.resource.data.sourceUrl is string
        && request.resource.data.sourceUrl.size() <= 2000
        && request.resource.data.filePath is string
        && request.resource.data.filePath.size() <= 1000
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() <= 240
        && request.resource.data.fileSize is int
        && request.resource.data.fileSize >= 0
        && request.resource.data.fileSize <= 25 * 1024 * 1024
        && request.resource.data.mimeType is string
        && (
          (
            request.resource.data.sourceMode == 'link'
            && request.resource.data.sourceUrl.matches('https://.+')
            && request.resource.data.filePath == ''
            && request.resource.data.fileName == ''
            && request.resource.data.fileSize == 0
            && request.resource.data.mimeType == ''
          )
          ||
          (
            request.resource.data.sourceMode == 'file'
            && request.resource.data.sourceUrl == ''
            && request.resource.data.filePath.matches(
              'knowledge-submissions/'
                + request.auth.uid
                + '/'
                + submissionId
                + '/[^/]+[.]pdf'
            )
            && request.resource.data.fileName.matches('.+[.]pdf')
            && request.resource.data.fileSize > 0
            && request.resource.data.mimeType == 'application/pdf'
          )
        )
        && request.resource.data.rightsConfirmed == true
        && request.resource.data.medicalConfirmed == true
        && request.resource.data.noPatientDataConfirmed == true
        && request.resource.data.moderationNote == ''
        && request.resource.data.moderatedBy == ''
        && request.resource.data.moderatedAt == null
        && request.resource.data.publishedAt == null
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validKnowledgeModeration() {
      return resource.data.origin == 'tutor'
        && resource.data.status == 'pending'
        && request.resource.data.origin == resource.data.origin
        && request.resource.data.submittedByUid
          == resource.data.submittedByUid
        && request.resource.data.status in ['published', 'rejected']
        && request.resource.data.moderationNote is string
        && request.resource.data.moderationNote.size() <= 1000
        && request.resource.data.moderatedBy == request.auth.uid
        && request.resource.data.moderatedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          (
            request.resource.data.status == 'published'
            && request.resource.data.publishedAt is timestamp
          )
          ||
          (
            request.resource.data.status == 'rejected'
            && request.resource.data.moderationNote.size() >= 3
            && request.resource.data.publishedAt == null
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'moderationNote',
          'moderatedBy',
          'moderatedAt',
          'publishedAt',
          'updatedAt'
        ]);
    }

    match /knowledgeSubmissions/{submissionId} {
      allow create: if hasUsableAccount()
        && validKnowledgeSubmissionCreate(submissionId);

      allow read: if isModerator()
        || (
          hasUsableAccount()
          && (
            resource.data.status == 'published'
            || resource.data.submittedByUid == request.auth.uid
          )
        );

      allow update: if isModerator() && validKnowledgeModeration();

      allow delete: if isModerator()
        || (
          hasUsableAccount()
          && resource.data.submittedByUid == request.auth.uid
          && resource.data.status in ['pending', 'rejected']
        );
    }

    function whiteboardBooking(bookingId) {
      return get(
        /databases/$(database)/documents/bookings/$(bookingId)
      ).data;
    }

    function canReadWhiteboard(bookingId) {
      return hasUsableAccount()
        && exists(
          /databases/$(database)/documents/bookings/$(bookingId)
        )
        && whiteboardBooking(bookingId).status in ['accepted', 'completed']
        && (
          whiteboardBooking(bookingId).studentUid == request.auth.uid
          || whiteboardBooking(bookingId).tutorUid == request.auth.uid
          || isModerator()
        );
    }

    function canWriteWhiteboard(bookingId) {
      return hasUsableAccount()
        && exists(
          /databases/$(database)/documents/bookings/$(bookingId)
        )
        && whiteboardBooking(bookingId).status == 'accepted'
        && (
          whiteboardBooking(bookingId).studentUid == request.auth.uid
          || whiteboardBooking(bookingId).tutorUid == request.auth.uid
        );
    }

    function isWhiteboardTutor(bookingId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/bookings/$(bookingId)
        )
        && whiteboardBooking(bookingId).tutorUid == request.auth.uid;
    }

    function validWhiteboardElement(data, elementId) {
      return data.keys().hasOnly([
          'id',
          'kind',
          'color',
          'size',
          'opacity',
          'authorUid',
          'authorName',
          'points',
          'x',
          'y',
          'endX',
          'endY',
          'text',
          'createdAtMs',
          'createdAt',
          'updatedAt'
        ])
        && data.id == elementId
        && data.kind in [
          'pen',
          'marker',
          'eraser',
          'line',
          'rectangle',
          'ellipse',
          'text'
        ]
        && data.color is string
        && data.color.size() <= 16
        && data.size is number
        && data.size >= 1
        && data.size <= 40
        && data.opacity is number
        && data.opacity >= 0.1
        && data.opacity <= 1
        && data.authorUid == request.auth.uid
        && data.authorName is string
        && data.authorName.size() <= 160
        && data.points is list
        && data.points.size() <= 1200
        && data.x is number
        && data.y is number
        && data.endX is number
        && data.endY is number
        && data.x >= 0
        && data.x <= 1
        && data.y >= 0
        && data.y <= 1
        && data.endX >= 0
        && data.endX <= 1
        && data.endY >= 0
        && data.endY <= 1
        && data.text is string
        && data.text.size() <= 500
        && data.createdAtMs is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /whiteboards/{bookingId} {
      allow read, write: if false;

      match /elements/{elementId} {
        allow read: if canReadWhiteboard(bookingId);
        allow create: if canWriteWhiteboard(bookingId)
          && validWhiteboardElement(request.resource.data, elementId);
        allow update: if canWriteWhiteboard(bookingId)
          && resource.data.authorUid == request.auth.uid
          && validWhiteboardElement(request.resource.data, elementId);
        allow delete: if isOwner()
          || (
            canWriteWhiteboard(bookingId)
            && (
              resource.data.authorUid == request.auth.uid
              || isWhiteboardTutor(bookingId)
            )
          );
      }
    }

    // MEDSTART_V6_MEDICAL_WORKSPACE_RULES
    function validMedicalWorkspace(data, bookingId) {
      return data.keys().hasOnly([
          'bookingId',
          'clinicalCase',
          'labs',
          'ecg',
          'privacy',
          'boardBackground',
          'updatedByUid',
          'createdAt',
          'updatedAt'
        ])
        && data.bookingId == bookingId
        && data.clinicalCase is map
        && data.labs is list
        && data.labs.size() <= 100
        && data.ecg is map
        && data.privacy is map
        && data.boardBackground is map
        && data.updatedByUid == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validMedicalAsset(data, bookingId, assetId) {
      return data.keys().hasOnly([
          'id',
          'bookingId',
          'uploaderUid',
          'uploaderName',
          'modality',
          'storagePath',
          'fileName',
          'mimeType',
          'fileSize',
          'deidentified',
          'createdAt'
        ])
        && data.id == assetId
        && data.bookingId == bookingId
        && data.uploaderUid == request.auth.uid
        && data.uploaderName is string
        && data.uploaderName.size() <= 160
        && data.modality in ['xray', 'ct', 'mri', 'ultrasound', 'ecg', 'other']
        && data.storagePath is string
        && data.storagePath.matches(
          'medical-workspaces/'
            + bookingId
            + '/'
            + request.auth.uid
            + '/.+'
        )
        && data.fileName is string
        && data.fileName.size() > 0
        && data.fileName.size() <= 160
        && data.mimeType in [
          'image/jpeg',
          'image/png',
          'image/webp',
          'application/dicom'
        ]
        && data.fileSize is int
        && data.fileSize > 0
        && data.fileSize <= 20 * 1024 * 1024
        && data.deidentified == true
        && data.createdAt is timestamp;
    }

    match /medicalWorkspaces/{bookingId} {
      allow read: if canReadWhiteboard(bookingId);
      // Медицинские поля записывает только сервер с валидацией и ревизиями.
      allow create, update: if false;
      allow delete: if isOwner();

      match /assets/{assetId} {
        allow read: if canReadWhiteboard(bookingId);
        // Пользовательские медицинские файлы отключены до внедрения
        // серверного обезличивания, карантина и проверки метаданных.
        allow create: if false;
        allow update: if false;
        allow delete: if isOwner()
          || (
            canWriteWhiteboard(bookingId)
            && (
              resource.data.uploaderUid == request.auth.uid
              || isWhiteboardTutor(bookingId)
            )
          );
      }
    }
  }
}
