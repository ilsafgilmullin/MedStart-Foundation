rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userExists(userId) {
      return firestore.exists(
        /databases/(default)/documents/users/$(userId)
      );
    }

    function userProfile(userId) {
      return firestore.get(
        /databases/(default)/documents/users/$(userId)
      ).data;
    }

    function isActiveUser(userId) {
      return signedIn()
        && request.auth.uid == userId
        && userExists(userId)
        && userProfile(userId).status == 'active';
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == 'm8JbbeeXMmZzywUwHboOyMm9MnG2';
    }

    function isActiveAdmin() {
      return signedIn()
        && userExists(request.auth.uid)
        && userProfile(request.auth.uid).role == 'admin'
        && userProfile(request.auth.uid).status == 'active';
    }

    function isModerator() {
      return isOwner() || isActiveAdmin();
    }

    function isActiveTutor(userId) {
      return isActiveUser(userId)
        && userProfile(userId).role == 'tutor';
    }

    function isPublishedSubmission(submissionId) {
      return firestore.exists(
          /databases/(default)/documents/knowledgeSubmissions/$(submissionId)
        )
        && firestore.get(
          /databases/(default)/documents/knowledgeSubmissions/$(submissionId)
        ).data.status == 'published';
    }

    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isActiveUser(userId)
        && request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isActiveUser(userId) || isModerator();
    }

    match /knowledge-submissions/{userId}/{submissionId}/{fileName} {
      allow read: if signedIn()
        && userExists(request.auth.uid)
        && userProfile(request.auth.uid).status == 'active'
        && (
          request.auth.uid == userId
          || isModerator()
          || isPublishedSubmission(submissionId)
        );

      allow create: if isActiveTutor(userId)
        && fileName.matches('.+[.]pdf')
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';

      allow update: if false;

      allow delete: if isActiveTutor(userId) || isModerator();
    }

    function bookingExists(bookingId) {
      return firestore.exists(
        /databases/(default)/documents/bookings/$(bookingId)
      );
    }

    function medicalBooking(bookingId) {
      return firestore.get(
        /databases/(default)/documents/bookings/$(bookingId)
      ).data;
    }

    function isActiveMedicalParticipant(bookingId) {
      return signedIn()
        && userExists(request.auth.uid)
        && userProfile(request.auth.uid).status == 'active'
        && bookingExists(bookingId)
        && (
          medicalBooking(bookingId).studentUid == request.auth.uid
          || medicalBooking(bookingId).tutorUid == request.auth.uid
        );
    }

    function canReadMedicalAsset(bookingId) {
      return bookingExists(bookingId)
        && (
          isModerator()
          || (
            isActiveMedicalParticipant(bookingId)
            && (
              medicalBooking(bookingId).status == 'accepted'
              || (
                medicalBooking(bookingId).status == 'completed'
                && medicalBooking(bookingId).completedAt is timestamp
                && request.time
                  < medicalBooking(bookingId).completedAt
                    + duration.value(180, 'd')
              )
            )
          )
        );
    }

    match /medical-workspaces/{bookingId}/{userId}/{fileName} {
      allow read: if canReadMedicalAsset(bookingId);

      // Critical safety gate: direct client uploads are disabled until MedStart
      // has a trusted server-side pipeline for malware scanning, EXIF/DICOM tag
      // removal and verification of burned-in patient identifiers.
      allow create, update: if false;

      allow delete: if isModerator()
        || (
          isActiveMedicalParticipant(bookingId)
          && (
            request.auth.uid == userId
            || medicalBooking(bookingId).tutorUid == request.auth.uid
          )
        );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
