{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "pnpm --filter @workspace/medstart dev",
    "build": "pnpm --filter @workspace/medstart typecheck && pnpm --filter @workspace/medstart build",
    "typecheck": "pnpm --filter @workspace/medstart typecheck"
  },
  "private": true,
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@playwright/test": "1.62.0",
    "firebase": "12.18.0",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
