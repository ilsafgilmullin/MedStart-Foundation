# Firebase web configuration is mandatory in every environment.
# MedStart intentionally has no built-in production fallback: development,
# preview and staging must point to an explicitly configured Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_URL=

# Серверный доступ Firebase. Проект service account должен совпадать с
# NEXT_PUBLIC_FIREBASE_PROJECT_ID. Укажите либо весь JSON одной строкой,
# либо три отдельных значения ниже. Не храните реальные ключи в Git.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Distributed auth rate limiting stores only keyed HMAC identifiers in Firestore.
# Use a random secret of at least 32 bytes and keep it only in server secrets.
MEDSTART_RATE_LIMIT_PEPPER=

# Forwarded IP headers are ignored unless this is explicitly enabled.
# Set true only after verifying that the deployment proxy overwrites
# X-Forwarded-For / X-Real-IP and does not trust values supplied by clients.
MEDSTART_TRUST_PROXY_HEADERS=false

# Before production, configure a Firestore TTL policy for
# securityRateLimits.expiresAt. Limiting correctness does not depend on TTL;
# the policy is for bounded retention/storage cleanup.

# Школьный трек/несовершеннолетние выключены по умолчанию до отдельной
# продуктовой, юридической и privacy-проработки. Backend-флаг является
# авторитетным; NEXT_PUBLIC-флаг управляет только отображением интерфейса.
MEDSTART_SCHOOL_TRACK_ENABLED=false
NEXT_PUBLIC_MEDSTART_SCHOOL_TRACK_ENABLED=false

# Учебные PDF публикуются только после fail-closed ClamAV INSTREAM scan.
# clamd TCP не имеет встроенной аутентификации/шифрования: держите его только
# в приватной сети/localhost и не публикуйте порт 3310 в интернет.
MEDSTART_CLAMAV_HOST=
MEDSTART_CLAMAV_PORT=3310
MEDSTART_CLAMAV_TIMEOUT_MS=12000

# Видео включается только при явном значении true/1/yes.
# Пока собственного сервера нет, оставьте false.
MEDSTART_LIVE_VIDEO_ENABLED=false

# Собственный LiveKit/SFU. LIVEKIT_URL начинается с wss://.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
