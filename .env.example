# Firebase web configuration is mandatory in every environment.
# MedStart intentionally has no built-in production fallback: development,
# preview and staging must point to an explicitly configured Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_URL=

# Серверный доступ Firebase. Проект service account должен совпадать с
# NEXT_PUBLIC_FIREBASE_PROJECT_ID. Укажите либо весь JSON одной строкой,
# либо три отдельных значения ниже. Не храните реальные ключи в Git.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Видео включается только при явном значении true/1/yes.
# Пока собственного сервера нет, оставьте false.
MEDSTART_LIVE_VIDEO_ENABLED=false

# Собственный LiveKit/SFU. LIVEKIT_URL начинается с wss://.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
