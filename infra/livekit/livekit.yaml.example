port: 7880

rtc:
  use_external_ip: true
  tcp_port: 7881
  udp_port: 7882

redis:
  address: redis.internal:6379
  username: ""
  password: "REPLACE_WITH_REDIS_PASSWORD"

turn:
  enabled: true
  domain: turn.example.ru
  tls_port: 5349
  udp_port: 3478
  cert_file: /etc/livekit/tls/fullchain.pem
  key_file: /etc/livekit/tls/privkey.pem

room:
  empty_timeout: 600
  departure_timeout: 120

logging:
  level: info

keys:
  REPLACE_WITH_API_KEY: REPLACE_WITH_API_SECRET
